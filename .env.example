# mock (default) — full local play with auto-accept trades
# live — requires Steam bot credentials + implementing sendLiveTrade()
STEAM_BOT_MODE=mock

# Optional display name for the bot
# STEAM_BOT_NAME=Scrapyard Bot

# Required only when STEAM_BOT_MODE=live
# STEAM_ACCOUNT_NAME=
# STEAM_PASSWORD=
# STEAM_SHARED_SECRET=
# STEAM_IDENTITY_SECRET=
# STEAM_BOT_STEAM_ID=
